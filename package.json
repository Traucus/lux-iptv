{
  "name": "lux-iptv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lux IPTV - Cinematic desktop IPTV player with licensing",
  "author": "",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n main,renderer,api -c blue,green,yellow \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:api\"",
    "dev:renderer": "vite",
    "dev:main": "concurrently \"tsc -p tsconfig.main.json --watch\" \"wait-on dist/main/index.js && electron .\"",
    "dev:api": "tsx watch src/licensing-api/server.ts",
    "build": "npm run build:renderer && npm run build:main && npm run build:api",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && electron-builder",
    "build:api": "tsc -p tsconfig.api.json",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.{ts,tsx}\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "api:license:create": "tsx src/licensing-api/cli/index.ts create",
    "api:license:list": "tsx src/licensing-api/cli/index.ts list",
    "api:license:revoke": "tsx src/licensing-api/cli/index.ts revoke"
  },
  "dependencies": {
    "electron": "^33.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.15",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/static": "^8.0.2",
    "drizzle-orm": "^0.36.3",
    "postgres": "^3.4.5",
    "dotenv": "^16.4.5",
    "node-machine-id": "^1.1.12",
    "commander": "^12.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/bcrypt": "^5.0.2",
    "vite": "^6.0.1",
    "@vitejs/plugin-react": "^4.3.3",
    "vitest": "^2.1.5",
    "@vitest/ui": "^2.1.5",
    "@vitest/coverage-v8": "^2.1.5",
    "@playwright/test": "^1.48.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint-plugin-react": "^7.37.2",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1",
    "drizzle-kit": "^0.28.1",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.lux.iptv",
    "productName": "Lux IPTV",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
