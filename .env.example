# Template for local environment variables
# Copy this file to .env.local and fill in real values
# .env.local is gitignored, .env.example is committed

# ============================================
# Xtream Codes API (DOC-2 / DOC-3 ingestion)
# ============================================
# Your IPTV provider's Xtream endpoint, username and password
# Example: XTREAM_URL=http://provider.example.com:8080
XTREAM_URL=
XTREAM_USER=
XTREAM_PASS=

# ============================================
# TMDB API (DOC-8 metadata enrichment)
# ============================================
# Get your API key at https://www.themoviedb.org/settings/api
# v3 auth (read access token) recommended for production
TMDB_API_KEY=

# ============================================
# Licensing Backend (DOC-6)
# ============================================
# Local Docker in dev, Hostinger VPS in prod
LICENSE_API_URL=http://localhost:3000

# Admin credentials for the /admin web UI (DOC-6)
# CHANGE THESE IN PRODUCTION
LICENSE_ADMIN_USER=admin
LICENSE_ADMIN_PASS=changeme

# ============================================
# Database (DOC-6 licensing backend)
# ============================================
# Format: postgresql://USER:PASS@HOST:PORT/DBNAME
# Default port 5432; override if you have port conflicts with other services
DATABASE_URL=postgresql://iptv:iptv@localhost:5432/iptv_licensing

# Override Postgres host port (default 5432). Change if 5432 is already taken.
POSTGRES_PORT=5432

# ============================================
# App configuration
# ============================================
NODE_ENV=development
LOG_LEVEL=debug
